{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:8b": {
          "name": "Qwen3 8B (local)",
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "deepseek-r1:14b": {
          "name": "DeepSeek R1 14B (solo consulta)"
        }
      }
    }
  },

  "instructions": [
    "AGENTS.md",
    "Responde en espanol neutro internacional. Usa tu con conjugacion estandar. Evita modismos regionales."
  ],

  "command": {
    "start": {
      "description": "Iniciar servidor de desarrollo React",
      "template": "Inicia el dev server:\n!`yarn start`\nEspera a que compile y reporta cualquier error."
    },
    "build": {
      "description": "Build de produccion React",
      "template": "Genera build de produccion:\n!`yarn build`\nReporta warnings, errores y tamano del bundle."
    },
    "test": {
      "description": "Ejecutar tests de React",
      "template": "Ejecuta los tests del frontend:\n!`yarn test --watchAll=false $ARGUMENTS`\nAnaliza los resultados y sugiere correcciones si hay fallos."
    },
    "lint": {
      "description": "Validar calidad de codigo",
      "template": "Ejecuta validacion de codigo:\n!`npx eslint src/ --ext .js,.jsx`\nReporta los problemas encontrados."
    },
    "audit": {
      "description": "Auditar dependencias",
      "template": "Audita dependencias por vulnerabilidades:\n!`yarn audit --level moderate`\nResume hallazgos criticos."
    }
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      "build/**",
      "dist/**",
      ".git/**",
      "*.log",
      "coverage/**",
      ".opencode/plans/**",
      ".opencode/templates/**",
      ".cache/**",
      "public/**"
    ]
  },

  "permission": {
    "skill": {
      "*": "allow"
    },
    "task": {
      "*": "allow"
    }
  },



  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/home/felipe/projects/ui_ikolu"],
      "enabled": true
    }
  },

  "plugin": [
    "@mohak34/opencode-notifier",
    "opencode-vibeguard",
    "opencode-supermemory"
  ]
}
